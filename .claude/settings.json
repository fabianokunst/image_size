{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check.mjs\" --session-start",
            "timeout": 60,
            "statusMessage": "Conferindo o projeto com o GitHub..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check.mjs\" --stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
